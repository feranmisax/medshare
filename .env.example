# Copy this file to ".env" and fill in your values.

# --- Database ---
# LOCAL Postgres (development). Format:
#   postgresql+psycopg2://USER:PASSWORD@HOST:PORT/DBNAME
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/pharma_redist

# When you move to the pilot, replace the line above with your cloud
# connection string (Neon/Supabase). Nothing else needs to change.

# --- Synthetic network size ---
N_PHARMACIES=150          # total pharmacies in the simulated network
SIM_DAYS=180              # days of daily sales history to generate
RANDOM_SEED=42            # reproducibility

# --- Matching engine ---
MATCH_THRESHOLD=0.65      # minimum score to surface a recommendation
K_NEAREST=10              # candidate pharmacies considered per at-risk batch
MAX_DISTANCE_KM=20        # urban transfer feasibility cap
SERVICE_LEVEL=0.8         # demand quantile used in the chance constraint

# --- API ---
API_HOST=127.0.0.1
API_PORT=8000
